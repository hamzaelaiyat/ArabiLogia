# ============================================================
# CLIENT-SAFE CONFIG — bundled into the app (APK/Linux/web).
# Anything here is PUBLIC: it ships inside the release artifacts
# and is readable by anyone who downloads them.
# Never put a secret in this file.
# ============================================================

# Supabase (required) — the anon key is protected by Row Level Security.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# SERVER-ONLY SECRETS — keep these OUT of .env
# Copy them into .env.secrets (git-ignored) for local tooling, and
# set them as Supabase Edge Function secrets / CI secrets.
# They are never needed by the Flutter app.
# ============================================================

# OneSignal (push notifications) — server-side only
# ONESIGNAL_API_KEY=

# Google AI (optional) — server-side only
# GOOGLE_AI=

# Sightengine (avatar moderation) — read by supabase/functions/mod-avatars
# via Deno.env, so set it with: supabase secrets set SE_API_USER=... SE_API_SECRET=...
# SE_API_USER=
# SE_API_SECRET=
# Fallback key pairs used when the primary hits a rate limit:
# SE_API_USER2=
# SE_API_SECRET2=
# SE_API_USER3=
# SE_API_SECRET3=
